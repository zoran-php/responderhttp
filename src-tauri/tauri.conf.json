{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ResponderHTTP",
  "version": "1.0.0",
  "identifier": "io.github.zoran-php.responderhttp",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ResponderHTTP",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Zoran Davidovic",
    "copyright": "© 2026 Zoran Davidovic",
    "category": "DeveloperTool",
    "shortDescription": "API client with libcurl built in",
    "longDescription": "ResponderHTTP is a desktop API client. Requests run through libcurl, statically linked into the binary, so no curl installation and no system SSL library are required. Collections, environments, history and cookies are stored locally in SQLite.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/installer.ico",
        "uninstallerIcon": "icons/uninstaller.ico",
        "headerImage": "icons/header.bmp",
        "uninstallerHeaderImage": "icons/uninstaller-header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
